# Copy this file to .env for local use. Never commit .env.
# On Netlify: Site configuration → Environment variables, then redeploy.
# Leave a key blank if you do not have it yet.

# Groq writes the practice questions. Create keys at https://console.groq.com/keys
# Add up to 10. The server rotates through them and skips a key that is
# rate-limited or rejected. GROQ_API_KEY is key 1.
GROQ_API_KEY=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
GROQ_API_KEY_8=
GROQ_API_KEY_9=
GROQ_API_KEY_10=
# Optional one-line alternative, combined with the slots above: key1,key2,key3
# GROQ_API_KEYS=
# Optional. Default is openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-20b

# Firebase Admin service-account JSON on one line.
# Leave empty to practise on this device without live sign-in.
FIREBASE_SERVICE_ACCOUNT=

# Paystack secret. Use sk_test_... while testing and sk_live_... in production.
PAYSTACK_SECRET_KEY=

# Public site origin, no path. Example: https://your-site.netlify.app
SITE_URL=

# Optional. Free full access ends at the end of this Lagos date. Default 2026-11-20.
# ORACLE_FREE_UNTIL=2026-11-20
